# dependencies & build output
node_modules/
.next/
out/
dist/
build/
target/
*.tsbuildinfo
__pycache__/
*.py[cod]
.venv/
venv/

# secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
# Vercel CLI link (project and org ids) and local Claude Code permissions
.vercel/
.claude/
# Written to the working directory by scripts/rehearse-*.sh (rehearsal logs)
# and scripts/upgrade-contracts.sh (unsigned multisig transactions).
rehearsal-*.log
*.xdr

# runtime state & collected data (lives on the server, not in git)
services/testnet-probe/results/
# On the collector it is a symlink to /var/lib/anchor-status/probe-results,
# which the trailing-slash pattern does not match.
services/testnet-probe/results
# The deploy's record of each service's installed dependencies.
.deps.sum
services/passive-monitor/output/
services/mainnet-probe/output/
services/mainnet-probe/results/
services/mainnet-probe/evidence/
services/testnet-probe/evidence/
services/testnet-probe/output/
services/aggregator/state.json

# os / editor
.DS_Store
Thumbs.db

# graphify: keep the graph + report, drop its caches and dated backups
graphify-out/cache/
graphify-out/20*/
graphify-out/*.sig
graphify-out/.graphify_python

# hackathon handout, not part of the project
*Stellar Pro Hackathon Tracks*.pdf

# Markdown: only the public documentation is published. Working notes
# (TODO, roadmap, demo script, prompts, plans) stay local, and so does any
# new .md file unless it is listed here.
*.md
!README.md
!**/README.md
!docs/SCORING.md
!docs/instaward/EVIDENCE.md
!docs/MAINNET_RUNBOOK.md
!docs/SECURITY.md
!graphify-out/GRAPH_REPORT.md
graphify-out/.graphify_*

# cargo-fuzz working data (corpus, crash reproductions)
contracts/*/fuzz/corpus/
contracts/*/fuzz/artifacts/
