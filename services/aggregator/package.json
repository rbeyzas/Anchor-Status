{
  "name": "@anchor-oracle/aggregator",
  "version": "0.1.0",
  "private": true,
  "description": "Submits RealMainnet/RealTestnet/SimulatedMock reports to PerformanceOracle on testnet, and computes and publishes each mainnet anchor's score card with its inputs bundle.",
  "type": "module",
  "scripts": {
    "aggregate": "tsx src/index.ts",
    "score": "tsx src/scoring/score-cli.ts",
    "verify-score": "tsx src/scoring/verify-score.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.0.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
