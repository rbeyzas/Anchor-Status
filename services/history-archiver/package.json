{
  "name": "@anchor-oracle/history-archiver",
  "version": "0.1.0",
  "private": true,
  "description": "Appends PerformanceOracle score/risk events and AnchorRegistry slash events to a durable archive, and can backfill and verify it against a long-retention RPC.",
  "type": "module",
  "scripts": {
    "archive": "tsx src/index.ts archive",
    "backfill": "tsx src/index.ts backfill",
    "verify": "tsx src/index.ts verify",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.0.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
