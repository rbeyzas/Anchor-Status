{
  "name": "@anchor-oracle/mainnet-probe",
  "version": "0.1.0",
  "private": true,
  "description": "Discovers every live SEP-6/24 anchor on mainnet and probes its public SEP-1/10/24 surface without moving funds.",
  "type": "module",
  "scripts": {
    "discover": "tsx src/discover.ts",
    "register": "tsx src/register.ts",
    "probe": "tsx src/run.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.0.1",
    "dotenv": "^16.4.5",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
